; Skyrim SE + Community Shaders. Generated configuration, not an installer.
; Mode: {{MODE}}
[Upscalers]
Dx11Upscaler=dlss_12
Dx12Upscaler=dlss

[FrameGen]
Enabled={{FG_ENABLED}}
FGInput={{FG_INPUT}}
FGOutput={{FG_OUTPUT}}
FGNvngxReplacement=None

[DLSSG]
; Two generated frames plus one rendered frame = 3X.
InterpolationCount=2
; External MFG Unlocker 1.6.1. Never combine with the built-in Ada unlock.
AdaMfgUnlock=false
UseGamesReflexMarkers=false

[Inputs]
EnableDlssInputs=true
EnableFfxInputs=false
EnableFsr2Inputs=false
EnableFsr3Inputs=false
EnableXeSSInputs=false

[DLSS]
Enabled=true

[Libraries]
OptiDllPath={{COMPANIONS}}
NvngxDlssPath={{GAME_STREAMLINE}}

[Spoofing]
Dxgi=false
StreamlineSpoofing=false

[fakenvapi]
UseFakenvapi=false

[Hooks]
EarlyHooking=true

[Plugins]
Path={{ASI_PLUGINS}}
LoadAsiPlugins={{LOAD_ASI}}

[NvApi]
; Retained from the tested configuration, not a universal recommendation.
DisableFlipMetering=true

[Menu]
Scale=1.5
ShortcutKey=45

[Log]
LogToFile=true
LogLevel=2
LogToConsole=false
OpenConsole=false
LogFileName={{LOG_FILE}}

[Hotfix]
CheckForUpdate=false

[DlssNr]
Enabled=true
ApplyModel=true
WorkingScale=0.5
ReversibleMode=3
; Post-SR keeps the tuned placement. Preset 2 is the FP8 performance network in nvngx_dlssnr.dll 310.9.
RunBeforeSR=false
Preset=2
AutoCapture=false
